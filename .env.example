# Copy this file to .env and fill in your real Supabase values.
# These are VITE_ prefixed so they are exposed to the browser client.
# The anon key is PUBLIC by design (RLS protects your data) — but never commit
# your real .env file. .env is already in .gitignore.

VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: if you run plain `vite` (not `vercel dev`) the serverless proxy at
# /api/tokens is not available locally. Point this at a deployed proxy instead,
# e.g. https://your-app.vercel.app/api/tokens
# VITE_TOKENS_URL=
